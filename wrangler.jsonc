{
  // Static-assets-only Worker: no `main` entry point, so there is no Worker
  // script and no runtime — Cloudflare just serves the files. Requests for
  // static assets are unmetered.
  //
  // Cloudflare Workers Builds deploys this on every push to main with a plain
  // `npx wrangler deploy`; the name below is the existing Worker and must not
  // change, or the next deploy creates a second one.
  "name": "website-privacykey",
  "compatibility_date": "2026-05-01",
  // Only the custom domain. A workers.dev or preview URL sits outside the
  // site's Cloudflare zone, so the zone's WAF rules, HSTS and Access policies
  // would not cover requests sent there. A dashboard-only switch is undone
  // by the next deploy; this setting is what sticks.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    // The site lives at the repository root. Everything here is public unless
    // listed in .assetsignore.
    // Serve 404.html (with a real 404 status) for paths that do not exist,
    // instead of an empty response. wrangler walks up from the requested
    // path looking for a 404.html, so the root one covers every route.
    "not_found_handling": "404-page",
    "directory": "."
  }
}
